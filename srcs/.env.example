# Copy to srcs/.env (`make env` does it) and change every "change-me".

# --- Django ---
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public address(es) of the site, with https:// (e.g. https://porte-a-porte.example.org). PUBLIC_URL is added
# automatically: needed behind an HTTPS reverse proxy, otherwise "CSRF Failed: Origin checking failed".
DJANGO_CSRF_TRUSTED_ORIGINS=
# Site administrator, created / promoted at startup. No password: log in with a code sent to this address
# (it also gives access to /admin/ once logged in on the site).
DJANGO_SUPERUSER_EMAIL=
TIME_ZONE=Europe/Berlin

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=canvassing
POSTGRES_USER=canvassing
POSTGRES_PASSWORD=change-me

# --- Email (login codes, invitations) ---
# Public URL of the site, used in the login links. Empty = the address the request came in on.
PUBLIC_URL=
# Brevo API key (https://app.brevo.com/settings/keys/api): emails are sent with Brevo's API.
# DEFAULT_FROM_EMAIL must then be a sender verified in Brevo.
CLE_API_BREVO=
# Otherwise, SMTP server. Empty EMAIL_HOST too = emails are printed in the backend logs (development).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Porte-à-porte <no-reply@example.org>
LOGIN_CODE_TTL_MINUTES=15
# Reverse proxies in front of the app (our nginx = 1): used to find the client IP for rate limiting.
NUM_PROXIES=1

# --- External services ---
# OpenRouteService key (https://account.heigit.org/manage/key). Empty = straight-line routes.
ORS_TOKEN=
# Custom Nominatim server (e.g. nominatimdeutschland.okras.eu:443). Empty = nominatim.openstreetmap.org
NOMINATIM_DOMAIN=
NOMINATIM_USER_AGENT=canvassing-web
# Optional self-hosted Photon server (typo-tolerant search), last resort for mistyped addresses. Empty = disabled.
PHOTON_DOMAIN=
CANVASSING_MAX_STOPS=250
CANVASSING_TOUR_TIMEOUT_HOURS=24

# --- Map ---
# CARTO basemaps API key (https://carto.com/basemaps). Sent to browsers: it is a public key.
# Empty = keyless CARTO tiles (rate-limited, fine for development).
CARTO_API_KEY=

# --- Nginx ---
# Port to access the site (make / make dev): http://localhost:${HTTP_PORT}
HTTP_PORT=8080
# Set to 1 when the site is served over HTTPS (reverse proxy / TLS in front): secure cookies
DJANGO_SECURE_COOKIES=0
